# ============================================
# WhatsApp AI Chatbot - Environment Variables
# ============================================
# এই file কপি করে .env নামে save করো
# তারপর নিচের values গুলো নিজের credentials দিয়ে replace করো
# Command: cp .env.example .env
# ============================================

# ------------------------------------------
# WhatsApp Cloud API (Meta Developer Dashboard)
# Get from: https://developers.facebook.com
# ------------------------------------------

# Phone Number ID - Meta Dashboard > WhatsApp > API Setup > From section
PHONE_NUMBER_ID=your_phone_number_id_here

# Access Token - Meta Dashboard > WhatsApp > API Setup > Temporary access token
# ⚠️ Temporary token 24 ghontay expire hoy! Notun token nite hobe
ACCESS_TOKEN=your_access_token_here

# Webhook Verify Token - nijer moto set koro (jeta khushi)
# Meta Dashboard > WhatsApp > Configuration > Edit > Verify Token
VERIFY_TOKEN=my_secret_verify_token_123

# ------------------------------------------
# AI API Keys (FREE!)
# ------------------------------------------

# Groq API Key (Primary AI - faster, better Bangla)
# Get from: https://console.groq.com/keys
# Free: 14,400 requests/day
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Fallback AI)
# Get from: https://aistudio.google.com/apikey
# Free: 1,500 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# Admin Settings
# ------------------------------------------

# Admin WhatsApp number (order notification pabe)
# Country code soho dao, e.g. 8801XXXXXXXXX
ADMIN_NUMBER=

# ------------------------------------------
# Server Config
# ------------------------------------------

# Server port (default 4000, 3000 e onno app thakle change koro)
PORT=4000